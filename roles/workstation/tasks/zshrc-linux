# Prevent double sourcing
if [[ -n "$_ZSHRC_SOURCED" ]]; then
    return
fi
export _ZSHRC_SOURCED=1

# Set the oh-my-posh theme name globally
OMP_THEME_NAME="night-owl.omp.json"
# OMP_THEME_NAME="atomic.omp.json"
# OMP_THEME_NAME="clean-detailed.omp.json"
# OMP_THEME_NAME="jandedobbeleer.omp.json"
# OMP_THEME_NAME="kushal.omp.json"

# Oh-my-posh theme setup (change OMP_THEME_NAME ^above to switch themes)
if command -v oh-my-posh >/dev/null 2>&1; then
    OMP_THEME_CMD=$(oh-my-posh init zsh --config "$HOME/.cache/oh-my-posh/themes/$OMP_THEME_NAME")
else
    OMP_THEME_CMD=""
fi

# Apply oh-my-posh theme if available
if [ -n "$OMP_THEME_CMD" ]; then
    eval "$OMP_THEME_CMD"
fi

# Python virtual environment configuration
PYTHON_VENV_NAME=".venv"
PYTHON_AUTO_VRUN=true
PYTHON_VENV_NAMES=($PYTHON_VENV_NAME venv)

# Oh My Zsh plugins (Linux-appropriate)
plugins=(git gh pip python systemd history-substring-search)

# Source Oh My Zsh
source $ZSH/oh-my-zsh.sh

# Set vi mode
set -o vi

# Load additional plugins if installed
# Syntax highlighting
if [ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
    source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# Auto suggestions
if [ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
    source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# History substring search
if [ -f /usr/share/zsh-history-substring-search/zsh-history-substring-search.zsh ]; then
    source /usr/share/zsh-history-substring-search/zsh-history-substring-search.zsh
fi

# WSL-specific aliases (only if running in WSL)
if grep -q microsoft /proc/version 2>/dev/null; then
    alias ssh='ssh.exe'
    alias ssh-add='ssh-add.exe'
fi

# 1Password login and environment variable loading alias
opload() {
    # op signin --raw emits only the session token on stdout, so nothing
    # produced by the CLI is ever evaluated (same pattern as the repo's
    # 1Password wrapper in roles/workstation/tasks/1password-security.yml).
    # The checked substitution also makes a failed login stop the load
    # (preserving the old alias's && short-circuit): a still-valid prior
    # session could otherwise let op inject succeed and report success
    # despite the failed login.
    local session
    if ! session="$(op signin --raw)"; then
        echo "opload: op signin failed, no environment variables were loaded" >&2
        return 1
    fi
    # Capture op inject output with a checked command substitution so its
    # exit status is visible: a process substitution would hide failures
    # (auth errors, missing $HOME/.env, bad templates) behind a clean loop.
    # The session is passed explicitly via --session.
    local output
    if ! output="$(op inject --session "$session" < "$HOME/.env")"; then
        echo "opload: op inject failed, no environment variables were loaded" >&2
        return 1
    fi
    # Only variable names declared by the $HOME/.env template may be
    # exported: a secret containing newlines cannot smuggle extra
    # assignments (e.g. "export PATH=/attacker") into the caller's shell.
    # declared_quote records whether each template line quoted its value
    # (with " or with '): only the template's own quote syntax is stripped
    # below, and an unquoted template preserves the value verbatim.
    local -A declared declared_quote
    local tmpl_line tmpl_key tmpl_val
    while IFS= read -r tmpl_line || [[ -n "$tmpl_line" ]]; do
        [[ -z "$tmpl_line" || "$tmpl_line" == \#* ]] && continue
        tmpl_key="${tmpl_line#export }"
        tmpl_key="${tmpl_key%%=*}"
        if [[ "$tmpl_key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            declared[$tmpl_key]=1
            tmpl_val="${tmpl_line#*=}"
            if [[ "$tmpl_val" == \"* && "$tmpl_val" == *\" ]]; then
                declared_quote[$tmpl_key]='"'
            elif [[ "$tmpl_val" == \'* && "$tmpl_val" == *\' ]]; then
                declared_quote[$tmpl_key]="'"
            else
                declared_quote[$tmpl_key]=""
            fi
        fi
    done < "$HOME/.env"
    local -a assignments
    local line key val quote c i assignment tmpl_q
    while IFS= read -r line; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        line="${line#export }"
        key="${line%%=*}"
        val="${line#*=}"
        if [[ ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ || -z "${declared[$key]:-}" ]]; then
            echo "opload: refusing to export variable '$key' (not declared in $HOME/.env)" >&2
            return 1
        fi
        # Quotes are template syntax only: track just the template's own
        # quote character (unquoted template lines get no tracking, since
        # quote characters in their values are data, not syntax). A quote
        # still open at end of line means the value continues on the next
        # physical line, which a line-based parser cannot represent safely,
        # so refuse.
        tmpl_q="${declared_quote[$key]:-}"
        if [[ -n "$tmpl_q" ]]; then
            quote=''
            for (( i = 1; i <= ${#val}; i++ )); do
                c="${val[i]}"
                if [[ -z "$quote" ]]; then
                    [[ "$c" == "$tmpl_q" ]] && quote="$c"
                elif [[ "$c" == "$quote" ]]; then
                    quote=''
                fi
            done
            if [[ -n "$quote" ]]; then
                echo "opload: value for '$key' has unbalanced quotes (multiline or malformed value); refusing to load" >&2
                return 1
            fi
            # Strip only the outer pair of the template's own quote style
            # so values that begin or end with any other character (e.g.
            # the other quote character) are preserved.
            if [[ "$val" == "$tmpl_q"*"$tmpl_q" ]]; then
                val="${val#"$tmpl_q"}"
                val="${val%"$tmpl_q"}"
            fi
        fi
        assignments+=("$key=$val")
    done <<< "$output"
    # Export only after every line validated, so a refusal loads nothing.
    for assignment in "${assignments[@]}"; do
        export "$assignment"
    done
    return 0
}

# Load environment variables from .env file with validation
if [ -f "$HOME/.env" ]; then
    # Check if user is already authenticated to 1Password (guard with command check)
    if command -v op >/dev/null 2>&1 && ! op whoami >/dev/null 2>&1; then
        echo "Use opload to load environment variables from .env"
    fi
else
    echo "Warning: .env file not found in $HOME"
    echo "Please create a .env file in your home directory with your 1Password secret references."
fi
