# Debian 13 (trixie) with systemd, matching Raspberry Pi OS, for Molecule scenarios
# that need to manage real services (ssh, ufw, fail2ban, NUT). Run privileged.
FROM debian:trixie

ENV container=docker

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        systemd systemd-sysv python3 python3-apt sudo ca-certificates iproute2 procps \
    && rm -rf /var/lib/apt/lists/*

STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]
